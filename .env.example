GREENLAB_PORT=3010
GREENLAB_DB_CLIENT=sqlite
GREENLAB_DB_PATH=data/greenlab-demo.sqlite

# PostgreSQL mode:
# GREENLAB_DB_CLIENT=postgres
# GREENLAB_DATABASE_URL=postgres://greenlab:change_me@127.0.0.1:5432/greenlab

CLEAN_CLOUD_API_BASE=https://cleancloudapp.com/api
# CLEAN_CLOUD_API_TOKEN=
# CLEAN_CLOUD_WEBHOOK_TOKEN=
CLEAN_CLOUD_SYNC_RETRY_LIMIT=5

GREENLAB_REQUIRE_WEBHOOK_TOKEN=false
GREENLAB_TRUST_PROXY=false
GREENLAB_DEMO_RESET_ON_BOOT=false
GREENLAB_SYNC_POLL_INTERVAL_MS=3000
