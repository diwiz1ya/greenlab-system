{
  "name": "green-lab-demo-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Local demo MVP for Green Lab laundry workflow",
  "scripts": {
    "start": "node server.js",
    "reset-demo": "node reset-demo.js",
    "capture:presentation": "node scripts/capture-presentation-screens.js",
    "capture:training:ru": "node scripts/capture-training-ru-screens.js",
    "audit:ui:lang": "node scripts/audit-ui-language.js",
    "export:presentation:pdf": "node scripts/export-presentation-pdf.js",
    "export:techdoc:pdf": "node scripts/export-techdoc-pdf.js",
    "export:training:pdf": "node scripts/export-training-pdf.js",
    "export:training:ru:full": "node scripts/export-training-ru-full-pdf.js",
    "labels:baskets": "python scripts/generate_bin_qr_labels.py",
    "test:all": "npm run audit:db-boundaries && npm run audit:db-schema && npm run test:sql-placeholders && node scripts/test-all.js",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js --latest",
    "db:doctor": "node scripts/db-doctor.js",
    "rotate:logs": "node scripts/rotate-logs.js",
    "monitor:health": "node scripts/monitor-health.js",
    "seed:scenario": "node scripts/seed-scenarios.js",
    "smoke:live": "node scripts/smoke-live-flow.js",
    "audit:workflow": "node scripts/audit-workflow-state.js",
    "audit:db-boundaries": "node scripts/audit-db-boundaries.js",
    "audit:db-schema": "node scripts/audit-db-schema-parity.js",
    "audit:db": "node scripts/audit-db-portability.js",
    "test:sql-placeholders": "node scripts/test-sql-placeholders.js",
    "ops:daily": "node scripts/backup-db.js --keep=21 && node scripts/rotate-logs.js --max-mb=10 --keep=7 && node scripts/monitor-health.js --max-failed=0 --max-pending=20 --max-processing=10"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "html5-qrcode": "^2.3.8"
  }
}
